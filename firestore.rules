rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHost() {
      return signedIn() && request.auth.token.email == 'host@event.app';
    }

    function isTeam() {
      return signedIn() && request.auth.token.email in [
        'team1@event.app', 'team2@event.app', 'team3@event.app',
        'team4@event.app', 'team5@event.app', 'team6@event.app'
      ];
    }

    function myTeamId() {
      return request.auth.token.email == 'team1@event.app' ? 'team-1' :
        request.auth.token.email == 'team2@event.app' ? 'team-2' :
        request.auth.token.email == 'team3@event.app' ? 'team-3' :
        request.auth.token.email == 'team4@event.app' ? 'team-4' :
        request.auth.token.email == 'team5@event.app' ? 'team-5' :
        request.auth.token.email == 'team6@event.app' ? 'team-6' : '';
    }

    function canClaimOwnTeam() {
      let existingTeam = resource.data.teams.get(myTeamId(), null);
      let existingLastSeenAt = existingTeam == null ? 0 : existingTeam.get('lastSeenAt', 0);
      let existingUid = existingTeam == null ? '' : existingTeam.get('uid', '');
      return isTeam()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams'])
        && request.resource.data.teams.diff(resource.data.teams).affectedKeys().hasOnly([myTeamId()])
        && request.resource.data.teams[myTeamId()].uid == request.auth.uid
        && (existingTeam == null || existingUid == request.auth.uid || request.time.toMillis() - existingLastSeenAt >= 30000);
    }

    function canTouchOwnTeam() {
      return isTeam()
        && myTeamId() in resource.data.teams.keys()
        && resource.data.teams[myTeamId()].uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams'])
        && request.resource.data.teams.diff(resource.data.teams).affectedKeys().hasOnly([myTeamId()])
        && request.resource.data.teams[myTeamId()].uid == request.auth.uid
        && request.resource.data.teams[myTeamId()].sessionId == resource.data.teams[myTeamId()].sessionId;
    }

    function ownsTeamInExistingGame() {
      return isTeam()
        && myTeamId() in resource.data.teams.keys()
        && resource.data.teams[myTeamId()].uid == request.auth.uid;
    }

    function onlyOwnRapidAnswerChanged() {
      let oldMinigame = resource.data.minigame;
      let newMinigame = request.resource.data.minigame;
      let questionIndex = oldMinigame.questionIndex;
      let oldAnswersForQuestion = oldMinigame.answers.get(string(questionIndex), {});
      let newAnswersForQuestion = newMinigame.answers.get(string(questionIndex), {});
      let answer = newAnswersForQuestion[myTeamId()];
      let oldScore = oldMinigame.scores.get(myTeamId(), 0);
      let newScore = newMinigame.scores.get(myTeamId(), 0);

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minigame'])
        && newMinigame.type == 'rapid-shooting'
        && newMinigame.status == 'playing'
        && newMinigame.questionCount == 5
        && newMinigame.questionIds.size() == 5
        && newMinigame.questionIds == oldMinigame.questionIds
        && newMinigame.questionIndex == questionIndex
        && newMinigame.startedAt == oldMinigame.startedAt
        && newMinigame.timeLimit == oldMinigame.timeLimit
        && newMinigame.questionCount == oldMinigame.questionCount
        && newMinigame.scores.diff(oldMinigame.scores).affectedKeys().hasOnly([myTeamId()])
        && newAnswersForQuestion.diff(oldAnswersForQuestion).affectedKeys().hasOnly([myTeamId()])
        && !(myTeamId() in oldAnswersForQuestion.keys())
        && myTeamId() in newAnswersForQuestion.keys()
        && answer.uid == request.auth.uid
        && answer.optionIndex >= 0
        && answer.optionIndex <= 3
        && answer.points >= 0
        && answer.points <= 150
        && newScore == oldScore + answer.points
        && request.time.toMillis() <= oldMinigame.startedAt.toMillis() + oldMinigame.timeLimit * 1000 + 250;
    }

    function canRollOwnTurn() {
      let oldPosition = resource.data.boardPositions.get(myTeamId(), 0);
      let newPosition = request.resource.data.boardPositions.get(myTeamId(), 0);
      let roll = request.resource.data.dice.value;
      let turnOrder = resource.data.turnOrder;
      let activeIndex = resource.data.activeTeamIndex;
      let nextIndex = (activeIndex + 1) % turnOrder.size();

      return isTeam()
        && resource.data.phase == 'playing'
        && resource.data.activeTeamId == myTeamId()
        && request.resource.data.dice.status == 'rolled'
        && request.resource.data.dice.teamId == myTeamId()
        && roll >= 1 && roll <= 6
        && request.resource.data.dice.rolledAt <= request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boardPositions', 'dice', 'activeTeamIndex', 'activeTeamId', 'round'])
        && request.resource.data.boardPositions.diff(resource.data.boardPositions).affectedKeys().hasOnly([myTeamId()])
        && newPosition == (oldPosition + roll > 29 ? 29 : oldPosition + roll)
        && request.resource.data.activeTeamIndex == nextIndex
        && request.resource.data.activeTeamId == turnOrder[nextIndex]
        && request.resource.data.round == (nextIndex == 0 ? resource.data.round + 1 : resource.data.round);
    }

    function canFinishOnDiceRoll() {
      let oldPosition = resource.data.boardPositions.get(myTeamId(), 0);
      let newPosition = request.resource.data.boardPositions.get(myTeamId(), 0);
      let roll = request.resource.data.dice.value;

      return isTeam()
        && resource.data.phase == 'playing'
        && resource.data.activeTeamId == myTeamId()
        && request.resource.data.phase == 'finished'
        && request.resource.data.winner == myTeamId()
        && request.resource.data.dice.status == 'rolled'
        && request.resource.data.dice.teamId == myTeamId()
        && roll >= 1 && roll <= 6
        && request.resource.data.dice.rolledAt <= request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boardPositions', 'dice', 'phase', 'winner', 'rankings'])
        && request.resource.data.boardPositions.diff(resource.data.boardPositions).affectedKeys().hasOnly([myTeamId()])
        && newPosition == 29
        && oldPosition + roll >= 29;
    }

    match /gameState/current {
      allow get: if signedIn();
      allow list: if false;
      allow create, delete: if isHost();
      allow update: if isHost()
        || canClaimOwnTeam()
        || canTouchOwnTeam()
        || (ownsTeamInExistingGame() && onlyOwnRapidAnswerChanged())
        || canRollOwnTurn()
        || canFinishOnDiceRoll();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
